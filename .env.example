# Copy this file to .env and populate the values. The real .env is git-ignored.
CLOP_USERNAME=
CLOP_PASSWORD=

# The exact name of your nation's tab in the shared planning sheet (e.g. LePone(Z)).
# The sheets.py startup check errors if this is unset or names no such tab.
CLOP_NATION=

# Optional Discord/Slack-compatible incoming webhook:
# CLOP_WEBHOOK_URL=
